{
  "compilerOptions": {
    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* JavaScript Version */
    "target": "ES2020",

    /* Module System */
    "module": "CommonJS",
    //"moduleResolution": "node",
    "ignoreDeprecations": "6.0",

    /* Interoperability */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,

    /* Debugging */
    "sourceMap": true,

    /* Output */
    "declaration": false,

    /* Consistency */
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}